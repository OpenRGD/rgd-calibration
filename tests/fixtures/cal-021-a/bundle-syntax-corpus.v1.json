      "syntax": "jsonc",
      "raw": "{\"meta_group\":{\"model_id_str\":\"first\"},\"meta_group\":{\"model_id_str\":\"second\"},\"joint_topology_map\":{},\"sensors_mounting_map\":{}}",
      "accepted": false
    },
    {
      "id": "duplicate-escaped-nested",
      "syntax": "jsonc",
      "raw": "{\"meta_group\":{\"model_id_str\":\"first\",\"\\u006dodel_id_str\":\"second\"},\"joint_topology_map\":{},\"sensors_mounting_map\":{}}",
      "accepted": false
    },
    {
      "id": "empty-object-comma",
      "syntax": "jsonc",
      "raw": "{\"meta_group\":{\"model_id_str\":\"bad\"},\"joint_topology_map\":{,},\"sensors_mounting_map\":{}}",
