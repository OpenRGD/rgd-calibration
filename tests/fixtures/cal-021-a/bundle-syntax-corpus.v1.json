      "syntax": "jsonc",
      "raw": "{\"meta_group\":{\"model_id_str\":\"bad\"},\"joint_topology_map\":{},\"sensors_mounting_map\":{}} /* unfinished",
      "accepted": false
    },
    {
      "id": "strict-json-rejects-comment",
      "syntax": "json",
      "raw": "{\"meta_group\":{\"model_id_str\":\"bad\"},\"joint_topology_map\":{},\"sensors_mounting_map\":{}} // comment",
      "accepted": false
    },
    {
      "id": "strict-json-rejects-trailing",
      "syntax": "json",
      "raw": "{\"meta_group\":{\"model_id_str\":\"bad\"},\"joint_topology_map\":{},\"sensors_mounting_map\":{},}",
      "accepted": false
    },
    {
      "id": "overflow-number",
      "syntax": "jsonc",
      "raw": "{\"meta_group\":{\"model_id_str\":\"bad\"},\"joint_topology_map\":{},\"sensors_mounting_map\":{},\"x\":1e999}",
      "accepted": false
    },
    {
      "id": "root-array",
      "syntax": "jsonc",
      "raw": "[]",
      "accepted": false
    }
  ]
