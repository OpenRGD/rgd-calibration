      "raw": "{\"meta_group\":{\"model_id_str\":\"bad\"},\"joint_topology_map\":{},\"sensors_mounting_map\":{},\"x\":[,]}",
      "accepted": false
    },
    {
      "id": "double-comma",
      "syntax": "jsonc",
      "raw": "{\"meta_group\":{\"model_id_str\":\"bad\"},\"joint_topology_map\":{},\"sensors_mounting_map\":{},,\"x\":1}",
      "accepted": false
    },
    {
      "id": "token-splitting",
      "syntax": "jsonc",
      "raw": "{\"meta_group\":{\"model_id_str\":\"bad\"},\"joint_topology_map\":{},\"sensors_mounting_map\":{},\"x\":1/*not a token join*/2}",
      "accepted": false
    },
    {
      "id": "missing-value",
      "syntax": "jsonc",
      "raw": "{\"meta_group\":{\"model_id_str\":\"bad\"},\"joint_topology_map\":{},\"sensors_mounting_map\":{},\"x\":,}",
      "accepted": false
